# Environment variables configuration for Sistem Informasi Sekolah

# PostgreSQL Connection String
# Sesuaikan username, password, host, port, dan database name
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sekolah_db?schema=public"

# Auth.js / NextAuth Configuration
# Generate random secret: openssl rand -base64 32
AUTH_SECRET="f6c80520268a2bf189bb53e7a02798e47f71120f269dc03c810b411d7fbebf91"
NEXTAUTH_URL="http://localhost:3000"

# Public App URL for SEO & OpenGraph
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare R2 Object Storage (Opsional: Jika tidak diisi, otomatis memakai Local Storage)
# Dapatkan dari Cloudflare Dashboard > R2 Object Storage > Manage R2 API Tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# URL Publik Bucket R2 (misal https://pub-xxxx.r2.dev atau domain kustom https://cdn.sekolahanda.sch.id)
R2_PUBLIC_URL=""
