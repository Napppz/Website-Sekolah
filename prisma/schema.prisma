generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  news      News[]

  @@map("users")
}

model SchoolProfile {
  id              String   @id @default(cuid())
  name            String
  npsn            String
  accreditation   String   @default("A")
  slogan          String
  description     String   @db.Text
  history         String   @db.Text
  vision          String   @db.Text
  mission         String   @db.Text
  goals           String   @db.Text
  principalName   String
  principalTitle  String
  principalSpeech String   @db.Text
  principalPhoto  String?
  address         String
  phone           String
  email           String
  website         String?
  mapsUrl         String?  @db.Text
  facebookUrl     String?
  instagramUrl    String?
  youtubeUrl      String?
  twitterUrl      String?
  updatedAt       DateTime @updatedAt

  @@map("school_profile")
}

model Major {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  slug              String             @unique
  description       String             @db.Text
  image             String?
  competencies      String             @db.Text
  careerProspects   String             @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  students          Student[]
  ppdbRegistrations PPDBRegistration[]

  @@map("majors")
}

model Teacher {
  id        String   @id @default(cuid())
  nip       String   @unique
  name      String
  title     String?
  gender    String
  position  String
  subject   String
  photo     String?
  email     String?
  phone     String?
  bio       String?  @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([subject])
  @@map("teachers")
}

model Student {
  id         String   @id @default(cuid())
  nisn       String   @unique
  nis        String   @unique
  name       String
  gender     String
  classGrade String
  majorId    String
  major      Major    @relation(fields: [majorId], references: [id], onDelete: Cascade)
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([classGrade])
  @@index([majorId])
  @@map("students")
}

model Facility {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  capacity    Int?
  condition   String   @default("Sangat Baik")
  description String   @db.Text
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("facilities")
}

model NewsCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  news      News[]

  @@map("news_categories")
}

model News {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  excerpt     String?      @db.Text
  content     String       @db.Text
  thumbnail   String?
  isPublished Boolean      @default(true)
  publishedAt DateTime     @default(now())
  views       Int          @default(0)
  categoryId  String
  category    NewsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([isPublished])
  @@map("news")
}

model Announcement {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  content        String   @db.Text
  fileAttachment String?
  isActive       Boolean  @default(true)
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@map("announcements")
}

model Event {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String    @db.Text
  location    String
  startDate   DateTime
  endDate     DateTime?
  poster      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startDate])
  @@map("events")
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  level       String
  year        Int
  participant String
  category    String
  photo       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([level])
  @@index([year])
  @@map("achievements")
}

model Gallery {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String
  category    String
  albumName   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("gallery")
}

model PPDBRegistration {
  id             String   @id @default(cuid())
  registrationNo String   @unique
  fullName       String
  nik            String
  nisn           String
  birthPlace     String
  birthDate      DateTime
  gender         String
  address        String   @db.Text
  previousSchool String
  phone          String
  email          String
  majorId        String
  major          Major    @relation(fields: [majorId], references: [id])
  documentUrl    String?
  status         String   @default("PENDING")
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([registrationNo])
  @@index([status])
  @@map("ppdb_registrations")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@map("contact_messages")
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // PPDB_NEW, CONTACT_NEW, PPDB_STATUS_CHANGE
  title     String
  message   String
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}
